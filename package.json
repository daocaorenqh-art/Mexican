{
  "name": "label-print-tool",
  "version": "0.14.0",
  "description": "本地安装运行的标签/条码设计与批量打印客户端，支持多种数据库套打",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/verify-2d.cjs && node tests/rawprint.test.cjs && node tests/datasource.test.cjs && node tests/zpl-compress.test.cjs",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "jsqr": "1.4.0",
    "@zxing/library": "0.23.0"
  },
  "dependencies": {},
  "optionalDependencies": {
    "better-sqlite3": "13.0.3",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "mssql": "11.0.2",
    "odbc": "2.6.0"
  },
  "build": {
    "appId": "com.local.labelprint",
    "productName": "标签打印工具",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "examples/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
