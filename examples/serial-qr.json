{
  "v": 2,
  "_note": "追溯标签示例：流水号 {#SN} 同时用在文字和二维码里；生产日期 / 保质期按打印当天自动计算；批号打印时弹窗输入。配合 serial-qr.csv。",
  "label": { "w": 60, "h": 40, "dpi": 203, "cols": 0, "gapX": 3, "gapY": 3, "pmode": "roll" },
  "elements": [
    { "type": "counter", "name": "SN", "x": 3, "y": 3, "size": 3.2, "bold": true, "prefix": "SN", "start": 1, "step": 1, "pad": 5, "every": 1, "per": "label", "radix": "10", "suffix": "", "persist": true, "rot": 0 },
    { "type": "text", "x": 3, "y": 9, "size": 3.2, "bold": false, "rot": 0, "content": "品名：{品名}" },
    { "type": "text", "x": 3, "y": 14, "size": 3, "bold": false, "rot": 0, "content": "批号：{?批号}" },
    { "type": "text", "x": 3, "y": 19, "size": 3, "bold": false, "rot": 0, "content": "生产：{#DATE:YYYY-MM-DD}" },
    { "type": "text", "x": 3, "y": 24, "size": 3, "bold": false, "rot": 0, "content": "=\"保质期至：\"+date(\"YYYY-MM-DD\",[保质期月],\"m\")" },
    { "type": "text", "x": 3, "y": 29, "size": 3, "bold": true, "rot": 0, "content": "=\"会员价：\"+fixed(mul([零售价],0.9),2)" },
    { "type": "qrcode", "x": 38, "y": 14, "size": 19, "ecl": "M", "rot": 0, "content": "{商品码}|{?批号}|{#SN}|{#DATE:YYYYMMDD}" }
  ]
}
